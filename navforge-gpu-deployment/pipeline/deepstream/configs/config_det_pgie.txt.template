# nvinfer_backport config — object detection
# Custom parser (parse-bbox-func-name) turns the raw output tensor(s) into
# NvDsInferObjectDetectionInfo boxes; nvinfer rescales them onto the frame and
# nvdsosd renders the boxes + labels from labelfile-path.
[property]
gpu-id=0
net-scale-factor=0.00392157
model-color-format=0
model-engine-file=MODEL_PLAN_PLACEHOLDER
infer-dims=3;640;640
network-input-order=0
batch-size=1
network-mode=2
process-mode=1
network-type=0
num-detected-classes=NUM_CLASSES_PLACEHOLDER
maintain-aspect-ratio=1
symmetric-padding=1
output-blob-names=output0
labelfile-path=LABELS_PLACEHOLDER
custom-lib-path=PARSER_PLACEHOLDER
parse-bbox-func-name=ParseConfigDetPgie
cluster-mode=4
output-tensor-meta=1
interval=0
gie-unique-id=1

[class-attrs-all]
pre-cluster-threshold=0.25
nms-iou-threshold=0.5
